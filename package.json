{
  "name": "@albert-wu/dsh-memory-manager",
  "version": "0.1.0",
  "description": "DeepSeek Harness 长期记忆管理插件：Web 管理面板、自动注入、四种策略、用户画像、自动沉淀与 AGENTS.md 桥接",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/shared.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts/check-release.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check:release": "node scripts/check-release.mjs",
    "test": "node test/p0-tests.mjs && node test/p1-tests.mjs && node test/p1-client-tests.mjs && node test/phase1-tests.mjs && node verify-p0-fixes.mjs",
    "prepack": "npm run check:release"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "memory-manager",
    "long-term-memory",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SWAlbert-0/dsh-memory-manager.git"
  },
  "homepage": "https://github.com/SWAlbert-0/dsh-memory-manager#readme",
  "bugs": {
    "url": "https://github.com/SWAlbert-0/dsh-memory-manager/issues"
  },
  "author": "SWAlbert-0",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
